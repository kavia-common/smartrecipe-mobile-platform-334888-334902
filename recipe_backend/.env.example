APP_ENV=development
APP_DEBUG=false

# Comma-separated list of allowed frontend origins.
# Use explicit origins for authenticated browser clients, for example:
# ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.example.com
# Use * only for non-credentialed local testing.
ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL connectivity. These values should come from the database container/environment.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smartrecipe
POSTGRES_USER=appuser
POSTGRES_PASSWORD=replace-me
# Optional full DSN override. When set, it takes precedence over the fields above.
# POSTGRES_URL=postgresql://appuser:replace-me@localhost:5432/smartrecipe

# JWT/token settings.
JWT_SECRET=request-from-user
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRY_MINUTES=60

# Analytics source label.
ANALYTICS_SOURCE=recipe_frontend
